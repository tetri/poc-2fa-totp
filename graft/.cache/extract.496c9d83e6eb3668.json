{"version":1,"extractor":"496c9d83e6eb3668","files":{"src/server.js":{"size":4272,"mtimeMs":1788345371914.2483,"hash":"da1c4cf76639321b135d9b86aa2704d56b8c67126a17d476987d03a31426851c","nodes":[{"id":"src/server.js","name":"server.js","kind":"file","path":"src/server.js","span":"L1-L71","signature":null,"exported":true,"origin":"ast","body_hash":"da1c4cf76639321b135d9b86aa2704d56b8c67126a17d476987d03a31426851c","chars":4264,"summary_state":"pending","summary":null,"crux":null,"body_text":"import 'dotenv/config'; import express from 'express'; import session from 'express-session'; import Database from 'better-sqlite3'; import bcrypt from 'bcryptjs'; import * as OTPAuth from 'otpauth'; import QRCode from 'qrcode'; import { mkdirSync } from 'node:fs'; import { login, enroll, verify, dashboard } from './views.js'; const app = express(); const port = Number(process.env.PORT || 3000); const appName = process.env.APP_NAME || 'POC 2FA'; mkdirSync('data', { recursive: true }); const db = new Database('data/auth.db'); db.pragma('journal_mode = WAL'); db.exec(`CREATE TABLE IF NOT EXISTS users ( id INTEGER PRIMARY KEY, username TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL, totp_secret TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP )`); if (!db.prepare('SELECT 1 FROM users WHERE username = ?').get('demo')) { db.prepare('INSERT INTO users (username, password_hash) VALUES (?, ?)').run('demo', bcrypt.hashSync('demo123', 12)); } app.use(express.urlencoded({ extended: false })); app.use(session({ secret: process.env.SESSION_SECRET || 'apenas-para-desenvolvimento', resave: false, saveUninitialized: false, cookie: { httpOnly: true, sameSite: 'lax', secure: false } })); const userById = db.prepare('SELECT id, username, totp_secret FROM users WHERE id = ?'); app.get('/', (req, res) => req.session.userId ? res.redirect('/dashboard') : res.send(login())); app.post('/login', (req, res) => { const user = db.prepare('SELECT * FROM users WHERE username = ?').get(req.body.username); if (!user || !bcrypt.compareSync(req.body.password || '', user.password_hash)) return res.status(401).send(login('Usuário ou senha inválidos.')); req.session.pendingUserId = user.id; res.redirect(user.totp_secret ? '/verify' : '/enroll'); }); app.get('/enroll', async (req, res) => { const user = getPendingUser(req); if (!user) return res.redirect('/'); if (user.totp_secret) return res.redirect('/verify'); if (!req.session.enrollmentSecret) req.session.enrollmentSecret = new OTPAuth.Secret({ size: 20 }).base32; const totp = new OTPAuth.TOTP({ issuer: appName, label: user.username, secret: OTPAuth.Secret.fromBase32(req.session.enrollmentSecret) }); const error = req.session.enrollmentError; delete req.session.enrollmentError; res.send(enroll({ qrCode: await QRCode.toDataURL(totp.toString()), secret: req.session.enrollmentSecret, error })); }); app.post('/enroll', (req, res) => { const user = getPendingUser(req); const secret = req.session.enrollmentSecret; if (!user || !secret) return res.redirect('/'); const candidate = { ...user, totp_secret: secret }; if (!validToken(candidate, req.body.token)) { req.session.enrollmentError = 'Código inválido. Aguarde um novo código e tente novamente.'; return res.redirect('/enroll'); } db.prepare('UPDATE users SET totp_secret = ? WHERE id = ?').run(secret, user.id); req.session.userId = user.id; delete req.session.pendingUserId; delete req.session.enrollmentSecret; res.redirect('/dashboard'); }); app.get('/verify', (req, res) => getPendingUser(req)?.totp_secret ? res.send(verify()) : res.redirect('/')); app.post('/verify', (req, res) => { const user = getPendingUser(req); if (!user?.totp_secret) return res.redirect('/'); if (!validToken(user, req.body.token)) return res.status(401).send(verify('Código inválido ou expirado.')); req.session.userId = user.id; delete req.session.pendingUserId; res.redirect('/dashboard'); }); app.get('/dashboard', requireAuth, (req, res) => res.send(dashboard(userById.get(req.session.userId).username))); app.post('/logout', (req, res) => req.session.destroy(() => res.redirect('/'))); app.listen(port, () => console.log(`POC disponível em http://localhost:${port}`));"},{"id":"src/server.js#getPendingUser","name":"getPendingUser","kind":"function","path":"src/server.js","span":"L33-L33","signature":"function getPendingUser(req)","exported":false,"origin":"ast","body_hash":"016c198deabf9773a7c5b4bbab1b6f38fa8a2353f1cb214199eac44ca85695ad","body_text":"function getPendingUser(req) { return req.session.pendingUserId && userById.get(req.session.pendingUserId); }","summary_state":"pending","summary":null,"crux":null},{"id":"src/server.js#totpFor","name":"totpFor","kind":"function","path":"src/server.js","span":"L34-L34","signature":"function totpFor(user)","exported":false,"origin":"ast","body_hash":"0f6030cd547c444a10f63c77523b69feb126305a2e64faa2fae7ffe21cb0d886","body_text":"function totpFor(user) { return new OTPAuth.TOTP({ issuer: appName, label: user.username, algorithm: 'SHA1', digits: 6, period: 30, secret: OTPAuth.Secret.fromBase32(user.totp_secret) }); }","summary_state":"pending","summary":null,"crux":null},{"id":"src/server.js#validToken","name":"validToken","kind":"function","path":"src/server.js","span":"L35-L35","signature":"function validToken(user, token)","exported":false,"origin":"ast","body_hash":"25e2ffd05332d16caf5731fe40dc374dafb7932b50aec220f23cd18c0c42a6e5","body_text":"function validToken(user, token) { return /^\\d{6}$/.test(token || '') && totpFor(user).validate({ token, window: 1 }) !== null; }","summary_state":"pending","summary":null,"crux":null},{"id":"src/server.js#requireAuth","name":"requireAuth","kind":"function","path":"src/server.js","span":"L36-L36","signature":"function requireAuth(req, res, next)","exported":false,"origin":"ast","body_hash":"ba07abff9a09ee33668e947374cce1af37d4db1f9232053b80e3ccfcadd05626","body_text":"function requireAuth(req, res, next) { if (!req.session.userId) return res.redirect('/'); next(); }","summar