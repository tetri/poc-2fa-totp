title><style>body{font-family:system-ui,sans-serif;max-width:440px;margin:48px auto;padding:0 20px;color:#172033}form{display:grid;gap:12px}input,button{font:inherit;padding:10px}button{cursor:pointer;background:#1769aa;color:white;border:0;border-radius:4px}.card{border:1px solid #d5dce5;border-radius:8px;padding:24px}.error{color:#b42318}.ok{color:#067647}img{max-width:260px;margin:auto}code{word-break:break-all}</style></head><body><main class=\"card\">${body}</main></body></html>`; }","summary_state":"pending","summary":null,"crux":null},{"id":"src/views.js#login","name":"login","kind":"function","path":"src/views.js","span":"L5-L7","signature":"function login(error = '')","exported":true,"origin":"ast","body_hash":"5510ed06da3af1ec3f93aa31e5d96abcba29f9ddea5e4e3b2d78cab3e0975ebb","body_text":"function login(error = '') { return layout('Entrar', `<h1>Entrar</h1>${error ? `<p class=\"error\">${error}</p>` : ''}<form method=\"post\" action=\"/login\"><label>Usuário<input name=\"username\" autocomplete=\"username\" required></label><label>Senha<input name=\"password\" type=\"password\" autocomplete=\"current-password\" required></label><button>Continuar</button></form><p>Demo: <code>demo</code> / <code>demo123</code></p>`); }","summary_state":"pending","summary":null,"crux":null},{"id":"src/views.js#enroll","name":"enroll","kind":"function","path":"src/views.js","span":"L9-L11","signature":"function enroll({ qrCode, secret, error = '' })","exported":true,"origin":"ast","body_hash":"83d0bdf9b4954bb143b4928e6dd729c997d89891be6df6583d336dab03a363b3","body_text":"function enroll({ qrCode, secret, error = '' }) { return layout('Configurar 2FA', `<h1>Configure seu autenticador</h1>${error ? `<p class=\"error\">${error}</p>` : ''}<ol><li>No Google ou Microsoft Authenticator, escolha adicionar conta e escaneie o QR code.</li><li>Digite abaixo o código exibido no app.</li></ol><img src=\"${qrCode}\" alt=\"QR code para configurar TOTP\"><p>Se não puder escanear, adicione uma chave manualmente: <code>${secret}</code></p><form method=\"post\" action=\"/enroll\"><label>Código de 6 dígitos<input name=\"token\" inputmode=\"numeric\" autocomplete=\"one-time-code\" pattern=\"[0-9]{6}\" maxlength=\"6\" required autofocus></label><button>Ativar 2FA</button></form>`); }","summary_state":"pending","summary":null,"crux":null},{"id":"src/views.js#verify","name":"verify","kind":"function","path":"src/views.js","span":"L13-L15","signature":"function verify(error = '')","exported":true,"origin":"ast","body_hash":"951ad646a471215fa0a13a0ecc730b7708e7fceab85b95332150c43761fd1e7c","body_text":"function verify(error = '') { return layout('Verificar 2FA', `<h1>Segundo fator</h1>${error ? `<p class=\"error\">${error}</p>` : ''}<p>Abra seu autenticador e informe o código atual.</p><form method=\"post\" action=\"/verify\"><label>Código de 6 dígitos<input name=\"token\" inputmode=\"numeric\" autocomplete=\"one-time-code\" pattern=\"[0-9]{6}\" maxlength=\"6\" required autofocus></label><button>Entrar</button></form>`); }","summary_state":"pending","summary":null,"crux":null},{"id":"src/views.js#dashboard","name":"dashboard","kind":"function","path":"src/views.js","span":"L17-L19","signature":"function dashboard(username)","exported":true,"origin":"ast","body_hash":"f441620af8a64c1eebe6f89c4960d5552a6f660f0c27ff5f1c7bbb7b01b4fcb6","body_text":"function dashboard(username) { return layout('Área autenticada', `<h1>Autenticação concluída</h1><p class=\"ok\">Você entrou como <strong>${username}</strong> usando senha e TOTP.</p><form method=\"post\" action=\"/logout\"><button>Sair</button></form>`); }","summary_state":"pending","summary":null,"crux":null}],"rawEdges":[{"source":"src/views.js","relation":"contains","targetId":"src/views.js#layout","file":"src/views.js"},{"source":"src/views.js","relation":"contains","targetId":"src/views.js#login","file":"src/views.js"},{"source":"src/views.js#login","relation":"calls","name":"layout","viaMember":false,"file":"src/vie